# Copy to .env — never commit real secrets.

OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_API_KEY=
LLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=180
OLLAMA_ENABLED=1

# Amen Securemail (port 465 = implicit SSL; do not enable TLS at the same time)
EMAIL_HOST=smtp-fr.securemail.pro
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_SENDER_NAME=L'équipe MediaCBD
# If set, every outgoing mail goes here (dev / loopback). Empty = real recipient.
EMAIL_FORCE_TO=
LISTING_NOTIFY_EMAIL=

MEDIA_NAME=MediaCBD
MEDIA_SITE_URL=https://mediacbd.fr
DIRECTORY_URL=https://mediacbd.fr/acteurs
EDITOR_FOOTER=MediaCBD
PRICE_HT=30
PRICE_TTC=36
PRICE_DOFOLLOW_TTC=50
PRICE_ARTICLE_TTC=80
CURRENCY=€
