# Copy to backend/.env on the server. Never commit real secrets.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=mediacbd.fr,www.mediacbd.fr,127.0.0.1,localhost
# Leave unset to use backend/staticfiles (no root paths needed).
# DJANGO_STATIC_ROOT=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0

CORS_ALLOWED_ORIGINS=https://mediacbd.fr,https://www.mediacbd.fr
CSRF_TRUSTED_ORIGINS=https://mediacbd.fr,https://www.mediacbd.fr

# --- MySQL (same VPS → localhost, not the public IP) ---
DB_ENGINE=mysql
DB_NAME=cbd
DB_USER=mediacbd
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Gunicorn (user-level, no sudo) ---
GUNICORN_BIND=127.0.0.1:8001
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Ollama (same VPS → localhost; otherwise the LAN/VPN URL) ---
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_API_KEY=
LLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=180
OLLAMA_ENABLED=1

# Amen Securemail (port 465 = implicit SSL; do not enable TLS at the same time)
EMAIL_HOST=smtp-fr.securemail.pro
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=contact@mediacbd.fr
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=contact@mediacbd.fr
EMAIL_SENDER_NAME="L'équipe MediaCBD"
EMAIL_FORCE_TO=
LISTING_NOTIFY_EMAIL=

MEDIA_NAME=MediaCBD
MEDIA_SITE_URL=https://mediacbd.fr
DIRECTORY_URL=https://mediacbd.fr/acteurs
EDITOR_FOOTER=MediaCBD
PRICE_HT=30
PRICE_TTC=36
PRICE_DOFOLLOW_TTC=50
PRICE_ARTICLE_TTC=80
CURRENCY=€
PAYMENT_METHOD=virement bancaire

# No systemd timer on this account — in-process reminders are fine.
PAYMENT_REMINDER_AFTER_DAYS=2
PAYMENT_REMINDER_INTERVAL_DAYS=2
PAYMENT_REMINDER_MAX=3
PAYMENT_REMINDER_AUTORUN=1
PAYMENT_REMINDER_POLL_SECONDS=3600
