# Copy to /var/www/mediacbd/backend/.env on the server. Never commit real secrets.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=mediacbd.fr,www.mediacbd.fr,127.0.0.1
DJANGO_STATIC_ROOT=/var/www/mediacbd/backend/staticfiles
# Nginx already redirects HTTP→HTTPS after certbot. Leave 0 unless Django must redirect too.
DJANGO_SECURE_SSL_REDIRECT=0
# Enable after HTTPS is live: 31536000
DJANGO_SECURE_HSTS_SECONDS=0

CORS_ALLOWED_ORIGINS=https://mediacbd.fr,https://www.mediacbd.fr
CSRF_TRUSTED_ORIGINS=https://mediacbd.fr,https://www.mediacbd.fr

# --- Gunicorn (optional overrides) ---
GUNICORN_BIND=unix:/run/mediacbd/gunicorn.sock
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Ollama ---
OLLAMA_URL=
OLLAMA_API_KEY=
LLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=180
OLLAMA_ENABLED=0

# Amen Securemail (port 465 = implicit SSL; do not enable TLS at the same time)
EMAIL_HOST=smtp-fr.securemail.pro
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_SENDER_NAME=L'équipe MediaCBD
EMAIL_FORCE_TO=
LISTING_NOTIFY_EMAIL=

MEDIA_NAME=MediaCBD
MEDIA_SITE_URL=https://mediacbd.fr
DIRECTORY_URL=https://mediacbd.fr/acteurs
EDITOR_FOOTER=MediaCBD
PRICE_HT=30
PRICE_TTC=36
PRICE_DOFOLLOW_TTC=50
PRICE_ARTICLE_TTC=80
CURRENCY=€
PAYMENT_METHOD=virement bancaire

# Relances: systemd timer, not the in-process Gunicorn thread
PAYMENT_REMINDER_AFTER_DAYS=2
PAYMENT_REMINDER_INTERVAL_DAYS=2
PAYMENT_REMINDER_MAX=3
PAYMENT_REMINDER_AUTORUN=0
PAYMENT_REMINDER_POLL_SECONDS=3600
